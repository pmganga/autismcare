# Copy this file to .env and fill in the values. Never share your .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# On the server (DJANGO_DEBUG=False): the site's https address, e.g. https://autismcare.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# False only to test production settings on this computer over plain http
DJANGO_SSL_REDIRECT=True

# PostgreSQL (SRS 2.4). On a host, set DATABASE_URL instead of DB_*:
# DATABASE_URL=postgres://user:password@host:5432/autismcare
# If neither is set, a local SQLite file is used instead.
DB_NAME=autismcare
DB_USER=autismcare_user
DB_PASSWORD=choose-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Teaching assistant: new flashcards come from a local Qwen model served by Ollama
# (https://ollama.com, then: ollama pull qwen3.5:2b). Leave OLLAMA_URL empty to
# turn AI off; the 60 built-in cards are always available.
OLLAMA_URL=http://127.0.0.1:11434
AI_FLASHCARDS_MODEL=qwen3.5:2b
